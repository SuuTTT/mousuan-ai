#!/usr/bin/env bash
set -euo pipefail

release_root="/opt/mousuan-site/releases"
current_link="/opt/mousuan-site/current"
keep_count="${1:-3}"

if [[ ! "$keep_count" =~ ^[0-9]+$ ]] || (( keep_count < 1 )); then
  echo "keep count must be a positive integer" >&2
  exit 2
fi

if [[ ! -d "$release_root" || ! -L "$current_link" ]]; then
  echo "unexpected Mousuan release layout" >&2
  exit 3
fi

current_site="$(readlink -f "$current_link")"
current_release="$(dirname "$current_site")"

mapfile -t releases < <(find "$release_root" -mindepth 1 -maxdepth 1 -type d -printf '%T@ %p\n' | sort -rn | cut -d' ' -f2-)

if (( ${#releases[@]} <= keep_count )); then
  echo "${#releases[@]} releases present; nothing to prune"
  exit 0
fi

kept=0
for release in "${releases[@]}"; do
  if [[ "$release" == "$current_release" ]] || (( kept < keep_count )); then
    ((kept += 1))
    continue
  fi

  case "$release" in
    "$release_root"/*) rm -rf --one-file-system "$release" ;;
    *) echo "refusing to remove unexpected path: $release" >&2; exit 4 ;;
  esac
done

echo "release retention complete; current release preserved"

